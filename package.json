{
  "name": "baka-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "art": "node scripts/art.mjs status",
    "art:prompts": "node scripts/art.mjs prompts",
    "art:build": "node scripts/art.mjs build && node scripts/gen-og.mjs",
    "art:clean": "node scripts/art.mjs clean"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.64.0",
    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "three": "^0.186.1"
  }
}
